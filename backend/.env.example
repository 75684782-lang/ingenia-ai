# --- Ingenia AI / Backend local ---
# Copia este archivo a .env y ajusta los valores.
# El servicio solo debe escuchar en localhost.
INGENIA_HOST=127.0.0.1
INGENIA_PORT=8000

# Solo para demos alojadas. En local debe quedar en false.
INGENIA_ALLOW_REMOTE=false
# Ponlo en true cuando el hosting sirva por HTTPS.
INGENIA_COOKIE_SECURE=false

# Token exigido por la API local (cabecera X-Ingenia-Token o cookie).
# Cambialo por un valor propio; el frontend lo recibe como cookie al abrir la app.
INGENIA_AUTH_TOKEN=ingenia-local-dev

# --- Ollama ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT=300

# --- Conector Civil 3D ---
# El complemento C# escucha UNICAMENTE en 127.0.0.1:8756.
CIVIL3D_BRIDGE_URL=http://127.0.0.1:8756
# Debe coincidir con el token configurado en el complemento.
CIVIL3D_TOKEN=cambia-este-token-compartido
# true = no intentar el bridge real; las operaciones devuelven mode=mock y NUNCA exito.
CIVIL3D_FALLBACK_TO_MOCK=true
CIVIL3D_TIMEOUT=30

# --- Persistencia ---
DATABASE_PATH=

# --- Limites ---
RATE_LIMIT_PER_MINUTE=120
MAX_TOOL_STEPS=4
